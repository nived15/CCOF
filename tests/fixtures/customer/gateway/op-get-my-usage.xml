<!--
  GET /ccof/me/usage: the caller's own budget figures (docs/USAGE.md), generated from configuration
  ccof-staged-gateway-1 (sha256 6f4f32826a1db244823565ebb6111500f69afd62cca9cd91667ba694a50c149d) and template sha256 41483f441d3ff2421451de750e91d415ab33b3a0b3df44ec811e23505c586ba7. Operation-scope
  policy of the operation get-my-usage: it has no <base />, so none of the API-scope (claude-messages)
  policy runs for this operation. Render with infra/gateway/render.ts; Stage 5 deploys it.
  The token checks (steps 1 and 2) are byte-for-byte those of claude-messages.template.xml
  (the gateway usage policy test compares them). The person ID sent to the resolver is the token's
  oid only; nothing from the request (query, headers, body) is read or forwarded.
-->
<policies>
	<inbound>
		<!-- 1. Authentication, as for /v1/messages. -->
		<validate-jwt id="ccof-jwt" header-name="Authorization" require-scheme="Bearer" failed-validation-httpcode="401" output-token-variable-name="ccofJwt">
			<openid-config url="https://login.microsoftonline.com/00000000-0000-4000-8000-000000100001/v2.0/.well-known/openid-configuration" />
			<audiences>
				<audience>api://00000000-0000-4000-8000-000000100002</audience>
				<audience>00000000-0000-4000-8000-000000100002</audience>
			</audiences>
			<issuers>
				<issuer>https://sts.windows.net/00000000-0000-4000-8000-000000100001/</issuer>
				<issuer>https://login.microsoftonline.com/00000000-0000-4000-8000-000000100001/v2.0</issuer>
			</issuers>
			<required-claims>
				<claim name="tid" match="all">
					<value>00000000-0000-4000-8000-000000100001</value>
				</claim>
			</required-claims>
		</validate-jwt>
		<!-- 2. The caller, as for /v1/messages: oid a GUID, the configured scope and client application. -->
		<set-variable name="ccofOid" value="@{&#xA;        var oid = ((Jwt)context.Variables[&quot;ccofJwt&quot;]).Claims.GetValueOrDefault(&quot;oid&quot;, &quot;&quot;).ToLowerInvariant();&#xA;        return System.Text.RegularExpressions.Regex.IsMatch(oid, &quot;^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$&quot;) ? oid : &quot;&quot;;&#xA;    }" />
		<set-variable name="ccofClientAppId" value="@{&#xA;        var jwt = (Jwt)context.Variables[&quot;ccofJwt&quot;];&#xA;        return jwt.Claims.GetValueOrDefault(&quot;azp&quot;, jwt.Claims.GetValueOrDefault(&quot;appid&quot;, &quot;&quot;)).ToLowerInvariant();&#xA;    }" />
		<set-variable name="ccofRefusal" value="@{&#xA;        if ((string)context.Variables[&quot;ccofOid&quot;] == &quot;&quot;) { return &quot;token_identity_missing&quot;; }&#xA;        var scopes = ((Jwt)context.Variables[&quot;ccofJwt&quot;]).Claims.GetValueOrDefault(&quot;scp&quot;, &quot;&quot;).Trim();&#xA;        if (scopes != &quot;&quot;) {&#xA;            if (!(&quot; &quot; + scopes + &quot; &quot;).Contains(&quot; access_as_user &quot;)) { return &quot;token_scope_missing&quot;; }&#xA;            var delegatedClients = new string[] { &quot;00000000-0000-4000-8000-000000100002&quot;, &quot;04b07795-8ddb-461a-bbee-02f9e1bf7b46&quot; };&#xA;            return Array.IndexOf(delegatedClients, (string)context.Variables[&quot;ccofClientAppId&quot;]) &gt;= 0 ? &quot;&quot; : &quot;token_client_not_allowed&quot;;&#xA;        }&#xA;        var testClients = new string[] {  };&#xA;        string[] roles;&#xA;        var hasRole = ((Jwt)context.Variables[&quot;ccofJwt&quot;]).Claims.TryGetValue(&quot;roles&quot;, out roles) &amp;&amp; roles != null &amp;&amp; Array.IndexOf(roles, &quot;&quot;) &gt;= 0;&#xA;        return false &amp;&amp; Array.IndexOf(testClients, (string)context.Variables[&quot;ccofClientAppId&quot;]) &gt;= 0 &amp;&amp; hasRole ? &quot;&quot; : &quot;app_token_not_allowed&quot;;&#xA;    }" />
		<!-- 3. Admission per person for this operation (10 calls per 60 s), its own counter. -->
		<choose>
			<when condition="@((string)context.Variables[&quot;ccofRefusal&quot;] == &quot;&quot;)">
				<rate-limit-by-key id="ccof-usage-person" calls="10" renewal-period="60" counter-key="@(&quot;ccof-usage:&quot; + (string)context.Variables[&quot;ccofOid&quot;])" retry-after-variable-name="ccofRetryAfter" />
			</when>
		</choose>
		<choose>
			<when condition="@((string)context.Variables[&quot;ccofRefusal&quot;] != &quot;&quot;)">
				<return-response>
					<set-status code="403" reason="Forbidden" />
					<set-header name="Content-Type" exists-action="override">
						<value>application/json</value>
					</set-header>
					<set-header name="Cache-Control" exists-action="override">
						<value>no-store</value>
					</set-header>
					<set-header name="x-ccof-request-id" exists-action="override">
						<value>@(context.RequestId.ToString())</value>
					</set-header>
					<set-body>@(new JObject(new JProperty("type", "error"), new JProperty("error", new JObject(new JProperty("type", "permission_error"), new JProperty("message", "This token cannot read usage from this gateway. Sign in with the gateway's client and try again. Request id: " + context.RequestId.ToString() + ".")))).ToString(Newtonsoft.Json.Formatting.None))</set-body>
				</return-response>
			</when>
		</choose>
		<!-- 4. The resolver, with APIM's managed identity (ADR-0009). Only the oid and the request id are sent. -->
		<authentication-managed-identity id="ccof-usage-resolver-credential" resource="00000000-0000-4000-8000-000000100003" output-token-variable-name="ccofResolverToken" ignore-error="true" />
		<set-header name="Authorization" exists-action="delete" />
		<choose>
			<when condition="@(context.Variables.ContainsKey(&quot;ccofResolverToken&quot;) &amp;&amp; !string.IsNullOrEmpty((string)context.Variables[&quot;ccofResolverToken&quot;]))">
				<send-request mode="new" response-variable-name="ccofUsageResponse" timeout="10" ignore-error="true">
					<set-url>https://fake-name-02.azurewebsites.net/api/me/usage</set-url>
					<set-method>POST</set-method>
					<set-header name="Content-Type" exists-action="override">
						<value>application/json</value>
					</set-header>
					<set-header name="Authorization" exists-action="override">
						<value>@("Bearer " + (string)context.Variables["ccofResolverToken"])</value>
					</set-header>
					<set-body>@(new JObject(new JProperty("personId", (string)context.Variables["ccofOid"]), new JProperty("requestId", context.RequestId.ToString())).ToString(Newtonsoft.Json.Formatting.None))</set-body>
				</send-request>
			</when>
		</choose>
		<set-variable name="ccofResolverToken" value="" />
		<!-- 5. Only a 200 with the expected schema is passed on; anything else is "try again shortly". -->
		<set-variable name="ccofUsageBody" value="@{&#xA;        var response = context.Variables.ContainsKey(&quot;ccofUsageResponse&quot;) ? context.Variables[&quot;ccofUsageResponse&quot;] as IResponse : null;&#xA;        if (response == null || response.StatusCode != 200) { return &quot;&quot;; }&#xA;        try {&#xA;            var body = response.Body.As&lt;JObject&gt;();&#xA;            return body != null &amp;&amp; body[&quot;schema&quot;] != null &amp;&amp; body[&quot;schema&quot;].Type == JTokenType.String &amp;&amp; (string)body[&quot;schema&quot;] == &quot;ccof.usage.v1&quot; &amp;&amp; body[&quot;scopes&quot;] is JArray&#xA;                ? body.ToString(Newtonsoft.Json.Formatting.None) : &quot;&quot;;&#xA;        } catch {&#xA;            return &quot;&quot;;&#xA;        }&#xA;    }" />
		<choose>
			<when condition="@((string)context.Variables[&quot;ccofUsageBody&quot;] != &quot;&quot;)">
				<return-response>
					<set-status code="200" reason="OK" />
					<set-header name="Content-Type" exists-action="override">
						<value>application/json</value>
					</set-header>
					<set-header name="Cache-Control" exists-action="override">
						<value>no-store</value>
					</set-header>
					<set-header name="x-ccof-request-id" exists-action="override">
						<value>@(context.RequestId.ToString())</value>
					</set-header>
					<set-body>@((string)context.Variables["ccofUsageBody"])</set-body>
				</return-response>
			</when>
			<otherwise>
				<return-response>
					<set-status code="503" reason="Service Unavailable" />
					<set-header name="Retry-After" exists-action="override">
						<value>5</value>
					</set-header>
					<set-header name="Content-Type" exists-action="override">
						<value>application/json</value>
					</set-header>
					<set-header name="Cache-Control" exists-action="override">
						<value>no-store</value>
					</set-header>
					<set-header name="x-ccof-request-id" exists-action="override">
						<value>@(context.RequestId.ToString())</value>
					</set-header>
					<set-body>@(new JObject(new JProperty("type", "error"), new JProperty("error", new JObject(new JProperty("type", "api_error"), new JProperty("message", "Usage figures are temporarily unavailable. Your access to Claude is not affected. Retry in 5 seconds. Request id: " + context.RequestId.ToString() + ".")))).ToString(Newtonsoft.Json.Formatting.None))</set-body>
				</return-response>
			</otherwise>
		</choose>
	</inbound>
	<backend>
		<!-- Never reached: inbound always returns. No <base />: nothing is forwarded to a model. -->
		<return-response>
			<set-status code="404" reason="Not Found" />
		</return-response>
	</backend>
	<outbound />
	<on-error>
		<!-- A token APIM rejects (401) or the per-person limit (429); anything else is 500. No <base />. -->
		<set-variable name="ccofUsageErrorStatus" value="@{&#xA;        if ((context.LastError.Source ?? &quot;&quot;) == &quot;validate-jwt&quot;) { return 401; }&#xA;        if ((context.LastError.PolicyId ?? &quot;&quot;) == &quot;ccof-usage-person&quot;) { return 429; }&#xA;        return 500;&#xA;    }" />
		<set-variable name="ccofUsageRetryAfter" value="@(Convert.ToString(context.Variables.GetValueOrDefault&lt;object&gt;(&quot;ccofRetryAfter&quot;, &quot;60&quot;)))" />
		<return-response>
			<set-status code="@((int)context.Variables[&quot;ccofUsageErrorStatus&quot;])" reason="@((int)context.Variables[&quot;ccofUsageErrorStatus&quot;] == 401 ? &quot;Unauthorized&quot; : ((int)context.Variables[&quot;ccofUsageErrorStatus&quot;] == 429 ? &quot;Too Many Requests&quot; : &quot;Internal Server Error&quot;))" />
			<set-header name="Content-Type" exists-action="override">
				<value>application/json</value>
			</set-header>
			<set-header name="Cache-Control" exists-action="override">
				<value>no-store</value>
			</set-header>
			<set-header name="Retry-After" exists-action="@((int)context.Variables[&quot;ccofUsageErrorStatus&quot;] == 429 ? &quot;override&quot; : &quot;delete&quot;)">
				<value>@((string)context.Variables["ccofUsageRetryAfter"])</value>
			</set-header>
			<set-header name="x-ccof-request-id" exists-action="override">
				<value>@(context.RequestId.ToString())</value>
			</set-header>
			<set-body>@{
          var status = (int)context.Variables["ccofUsageErrorStatus"];
          var type = status == 401 ? "authentication_error" : status == 429 ? "rate_limit_error" : "api_error";
          var message = status == 401 ? "Sign in to the gateway again (ccof-token login), then retry."
              : status == 429 ? "Usage was asked for too often. Wait for the time in the Retry-After header."
              : "The gateway hit an unexpected error reading usage. Retry; if this continues, tell your platform team.";
          return new JObject(new JProperty("type", "error"), new JProperty("error", new JObject(new JProperty("type", type), new JProperty("message", message + " Request id: " + context.RequestId.ToString() + ".")))).ToString(Newtonsoft.Json.Formatting.None);
      }</set-body>
		</return-response>
	</on-error>
</policies>