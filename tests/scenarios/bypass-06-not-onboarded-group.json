  "invariants": [
    "SEC-01",
    "SEC-07"
  ],
  "layer": "gateway",
  "given": {
    "groups": {
      "alpha": {
        "priority": 1,
        "models": [
          "claude-haiku-4-5",
          "claude-sonnet-5"
        ],
        "budget": "10"
      },
      "beta": {
        "priority": 2,
        "models": [
          "claude-haiku-4-5"
        ],
        "budget": "1"
      }
    },
    "callerIn": [
      "alpha",
      "beta",
      "gamma"
    ],
    "spend": {}
  },
  "when": {
